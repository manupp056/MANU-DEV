---
const { entry, base, view } = Astro.props;
const { id, data } = entry;
---

<article class="manu-activity">
	<div class="manu-activity__meta">
		<span>{data.codigo}</span>
		<span class="manu-activity__status">{data.estado || 'Revisada'}</span>
	</div>
	<h4><a href={`${base}/${id}/`}>{data.title}</a></h4>
	{data.description && <p>{data.description}</p>}
	{data.version_entrega && <p class="manu-activity__version">Versión de entrega: {data.version_entrega}</p>}
	{view === 'entregas' && (
		<>
			{data.archivos.length > 0 ? (
				<ul>{data.archivos.map((file) => (
					<li><a href={`${base}/entregables/${file.split('/').map(encodeURIComponent).join('/')}`}>{file.split('/').at(-1)}</a></li>
				))}</ul>
			) : <p class="manu-activity__note">Original conservado localmente; no publicado.</p>}
		</>
	)}
	{view === 'evolucion' && <p class="manu-activity__note">Estado: {data.estado || 'Revisada'}{data.fecha ? ` · ${data.fecha}` : ''}</p>}
</article>
