---
import { getCollection } from 'astro:content';
import ActivityCard from './ActivityCard.astro';

const { view } = Astro.props;
const activities = (await getCollection('docs', ({ id }) => id.startsWith('actividades/')))
	.filter(({ data }) => !data.draft)
	.sort((a, b) => a.id.localeCompare(b.id, 'es', { numeric: true }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modules = new Map();
for (const activity of activities) {
	const moduleName = activity.data.modulo || 'Módulo sin asignar';
	const unitName = activity.data.unidad || 'Unidad sin asignar';
	const lessonName = activity.data.leccion || 'Lección no indicada en el informe';
	if (!modules.has(moduleName)) modules.set(moduleName, new Map());
	const units = modules.get(moduleName);
	if (!units.has(unitName)) units.set(unitName, new Map());
	const lessons = units.get(unitName);
	if (!lessons.has(lessonName)) lessons.set(lessonName, []);
	lessons.get(lessonName).push(activity);
}
const groups = [...modules].map(([module, units]) => ({
	module,
	units: [...units].map(([unit, lessons]) => ({
		unit,
		lessons: [...lessons].map(([lesson, entries]) => ({ lesson, entries })),
	})),
}));

---

{groups.map(({ module, units }) => (
	<section class="manu-module">
		<h2>{module}</h2>
		{units.map(({ unit, lessons }) => (
			<section class="manu-unit">
				<h3>{unit}</h3>
				{lessons.map(({ lesson, entries }) => (
					<div class="manu-lesson">
						<h4>{lesson}</h4>
						<div class="manu-activity-list">
							{entries.map((entry) => <ActivityCard entry={entry} base={base} view={view} />)}
						</div>
					</div>
				))}
			</section>
		))}
	</section>
))}
{activities.length === 0 && <p>Todavía no hay actividades verificadas para publicar.</p>}
